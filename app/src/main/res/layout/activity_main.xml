<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1116"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="32dp"
        android:paddingTop="16dp"
        android:paddingRight="32dp"
        android:paddingBottom="24dp">

        <!-- Sayaç kartı + sağ üstte ayarlar (dişli) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TV KAPANMA ZAMANLAYICISI"
                    android:textColor="#8A94A6"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kapalı"
                    android:textColor="#03DAC5"
                    android:textSize="42sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#AAB4C3"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnExtend"
                style="@style/TvButton.Primary"
                android:text="+15 dk" />

            <Button
                android:id="@+id/btnStop"
                style="@style/TvButton.Danger"
                android:text="İptal" />

            <ImageButton
                android:id="@+id/btnSettings"
                style="@style/TvButton"
                android:layout_gravity="top"
                android:layout_marginLeft="12dp"
                android:contentDescription="Ayarlar"
                android:padding="10dp"
                android:src="@drawable/ic_settings"
                android:tint="@color/btn_tv_text" />
        </LinearLayout>

        <!-- Süre -->
        <TextView
            style="@style/SectionTitle"
            android:text="SÜRE" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button android:id="@+id/btn15" style="@style/TvButton" android:text="15 dk" />
                <Button android:id="@+id/btn30" style="@style/TvButton" android:text="30 dk" />
                <Button android:id="@+id/btn45" style="@style/TvButton" android:text="45 dk" />
                <Button android:id="@+id/btn60" style="@style/TvButton" android:text="1 saat" />
                <Button android:id="@+id/btn90" style="@style/TvButton" android:text="1,5 saat" />
                <Button android:id="@+id/btn120" style="@style/TvButton" android:text="2 saat" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:background="#2E3640" />

                <Button android:id="@+id/btnMinus" style="@style/TvButton" android:text="−" />

                <TextView
                    android:id="@+id/tvCustom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minWidth="72dp"
                    android:text="45 dk"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button android:id="@+id/btnPlus" style="@style/TvButton" android:text="+" />
                <Button android:id="@+id/btnStartCustom" style="@style/TvButton.Primary" android:text="Başlat" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Her gün belirli saatte -->
        <TextView
            style="@style/SectionTitle"
            android:text="HER GÜN BELİRLİ SAATTE KAPAT" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button android:id="@+id/btnSchedule" style="@style/TvButton" android:text="Kapalı" />
                <Button android:id="@+id/btnHourMinus" style="@style/TvButton" android:text="−1 sa" />

                <TextView
                    android:id="@+id/tvScheduleTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minWidth="84dp"
                    android:text="01:00"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <Button android:id="@+id/btnHourPlus" style="@style/TvButton" android:text="+1 sa" />
                <Button android:id="@+id/btnMinuteMinus" style="@style/TvButton" android:text="−5 dk" />
                <Button android:id="@+id/btnMinutePlus" style="@style/TvButton" android:text="+5 dk" />

                <TextView
                    android:id="@+id/tvScheduleInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="12dp"
                    android:textColor="#AAB4C3"
                    android:textSize="13sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- İzle -->
        <TextView
            style="@style/SectionTitle"
            android:text="İZLE  —  zamanlayıcı hangi uygulamayı açarsanız açın çalışır" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/appsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tvShortcutHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginLeft="4dp"
            android:textColor="#6B7380"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
